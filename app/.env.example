# Amazon Cognito User Pool domain, including https:// and no trailing slash
COGNITO_DOMAIN=https://your-domain.auth.ap-south-1.amazoncognito.com

# App client values from Cognito. Keep the secret private.
COGNITO_CLIENT_ID=your_app_client_id
COGNITO_CLIENT_SECRET=your_app_client_secret

# Must exactly match an Allowed callback URL in Cognito.
COGNITO_CALLBACK_URL=https://didactic-fortnight-wrrjx9w464wwcr7p-3000.app.github.dev/auth/callback

# Must exactly match an Allowed sign-out URL in Cognito.
COGNITO_SIGNOUT_URL=https://didactic-fortnight-wrrjx9w464wwcr7p-3000.app.github.dev/
